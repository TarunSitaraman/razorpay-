# Yukti configuration.
#
# Copy to `.env` and fill in whatever you have. EVERYTHING HERE IS OPTIONAL.
# Yukti runs correctly with none of it set: the deterministic layer — stopping
# rules, budget allocation, the policy engine, the dispatcher — does not depend
# on any model. An LLM improves how well the system EXPLAINS itself. It never
# decides anything that moves money.
#
# Check what is actually live at any time:
#     python -m yukti.cli llm-status

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Set a key for any of the providers below and Yukti will use it. Providers are
# tried in order; one with no key is skipped without opening a socket, and one
# that fails permanently (bad key, blocked host) is dropped for the rest of the
# process rather than re-tried on every call.
#
# Set at least one if you want the agent's narratives. None of them is required.

# Google Gemini — free tier, no card. Get a key at aistudio.google.com.
# The most generous free option, and the one this project is verified against.
# GEMINI_API_KEY=

# Groq — free tier, by far the fastest inference. console.groq.com
# GROQ_API_KEY=

# Cerebras — free tier, also very fast. cloud.cerebras.ai
# CEREBRAS_API_KEY=

# OpenRouter — aggregates many providers; models suffixed `:free` cost nothing.
# openrouter.ai/keys
# OPENROUTER_API_KEY=

# Mistral — free experiment tier. console.mistral.ai
# MISTRAL_API_KEY=

# GitHub Models — uses an ordinary GitHub personal access token, which is often
# the one credential a developer already has. github.com/marketplace/models
# GITHUB_TOKEN=

# Together AI — a few free models. api.together.xyz
# TOGETHER_API_KEY=

# Ollama — fully local, no key, no network. Install from ollama.com, then
# `ollama pull llama3.2`. The only option where no data leaves the machine,
# which is the one that matters if you have a hard data-residency boundary.
# Detected automatically at http://localhost:11434 — nothing to set here.

# Anthropic — not free, but the strongest structured-output support. Last in the
# default order, so it is used only when nothing free is configured.
# ANTHROPIC_API_KEY=

# Provider order, comma-separated. Leave unset for the default
# (gemini, groq, cerebras, openrouter, mistral, github, together, ollama, anthropic).
# YUKTI_LLM_PROVIDERS=groq,gemini,ollama

# Model ids drift as providers rename and retire them. Override per provider and
# per tier when a default goes stale — a wrong id costs a fall-through to the
# next provider, not an outage.
# YUKTI_GEMINI_MODEL_FAST=gemini-2.0-flash
# YUKTI_GEMINI_MODEL_PLANNER=gemini-2.0-flash
# YUKTI_GROQ_MODEL_PLANNER=llama-3.3-70b-versatile

# Cache structured responses to disk, keyed on the question rather than the
# provider. Makes a repeated demo cost zero API calls and replay identically.
# YUKTI_LLM_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Infrastructure — defaults match `make up`, so you only need these if you
# moved something.
# ---------------------------------------------------------------------------
# YUKTI_DATABASE_URL=postgresql://yukti:yukti@localhost:5432/yukti
# YUKTI_REDIS_URL=redis://localhost:6379/0
# YUKTI_KAFKA_BOOTSTRAP=localhost:9092
# YUKTI_SANDBOX_URL=http://localhost:8081
# YUKTI_API_PORT=8080

# Shared secret the payments sandbox signs webhooks with and the Go edge
# verifies. Mirrors how Razorpay signs webhooks. Change it for anything real.
# YUKTI_WEBHOOK_SECRET=yukti_dev_webhook_secret

# Global holdout percentage. This is the denominator that makes an incremental
# lift claim meaningful — setting it to 0 disables the ability to measure
# anything, which is the one number worth not touching.
# YUKTI_HOLDOUT_PCT=10.0

# YUKTI_SEED=20260822
